# Copy to .env and fill in. Env vars use "__" to separate config sections.

TimeFlip__Email=you@example.com
TimeFlip__Password=your-timeflip-password

# Personal API token from the CRM: Profile -> API tokens.
# Scopes: time.read, time.write, links.read.
Crm__Token=crm_pat_your-token
# Crm__BaseUrl=https://crm.green-cloud.nl
# Crm__TimeZone=Europe/Amsterdam

Sync__IntervalMinutes=60
# Window re-scanned by each scheduled pass. Keep it short; use the "Days back"
# box in the UI (or POST /sync?lookbackDays=N) to reach further back on demand.
Sync__LookbackDays=1
Sync__MaxManualLookbackDays=90
# Set to true to log actions without writing to the CRM.
Sync__DryRun=false
# Ignore TimeFlip tasks with no mapping rule instead of failing the pass.
Sync__SkipUnmapped=true
# Optional secret protecting POST /sync (sent as X-Trigger-Token). Leave empty to disable auth.
Sync__TriggerToken=
